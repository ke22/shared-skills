      },
      "semantic": {
        "note": "L1 semantic layer. Components use these names; only the base layer (css) holds colour values. Generated into templates/iasdr.css between deck-tokens:semantic markers by scripts/sync-tokens.mjs.",
        "channels": {
          "structure": "固定出現的系統元素：眉標、編號、表頭、流程線、圖解節點、標註線。不代表重要，也不代表好壞。",
          "emphasis": "作者選的重點，一頁一處：標題 .hl、焦點框 C27、強調文字 .acc。",
          "status": "評估或進度的狀態：判定、狀態點、錯誤與警示。一律配形狀與文字，不借用結構藍。",
          "category": "分類與角色，最多 4 種，以明度區分，一律配標籤。",
          "interaction": "連結與可點元素，只用在互動 HTML 與展示頁。"
        },
        "tokens": [
          {
            "name": "--struct-mark",
            "ref": "--accent",
            "channel": "structure",
            "usage": "眉標、編號、數字、圖解節點與箭頭、流程圓點、錨點",
            "uses": [
              "ink",
              "fill"
            ]
          },
          {
            "name": "--struct-line",
            "ref": "--accent-2",
            "channel": "structure",
            "usage": "虛線、標籤欄、表格鍵欄、網絡線、時程條次色",
            "uses": [
              "ink"
            ]
          },
          {
            "name": "--struct-fill",
            "ref": "--chip",
            "channel": "structure",
            "usage": "實心膠囊、表頭、代號標籤、結論橫幅的底色（白字 ≥ 4.5:1）",
            "uses": [
              "fill"
            ]
          },
          {
            "name": "--struct-muted",
            "ref": "--accent-soft",
            "channel": "structure",
            "usage": "未到達的段落、流程底線、空的佔位框；不可承載文字",
            "uses": [
              "line"
            ]
          },
          {
            "name": "--emph",
            "ref": "--accent",
            "channel": "emphasis",
            "usage": "標題上色的關鍵詞、焦點框、強調文字",
            "uses": [
              "ink"
            ]
          },
          {
            "name": "--status-met",
            "ref": "--ink",
            "channel": "status",
            "usage": "達成、有、已處理",
            "uses": [
              "ink",
              "fill"
            ]
          },
          {
            "name": "--status-partial",
            "ref": "--warning",
            "channel": "status",
            "usage": "部分達成、警示、斷點",
            "uses": [
              "ink",
              "fill"
            ]
          },
          {
            "name": "--status-partial-soft",
            "ref": "--warning-soft",
            "channel": "status",
            "usage": "警示或斷點的底色",
            "uses": [
              "surface"
            ]
          },
          {
            "name": "--status-gap",
            "ref": "--danger",
            "channel": "status",
            "usage": "尚未達成、錯誤、高風險",
            "uses": [
              "ink",
              "fill"
            ]
          },
          {
            "name": "--status-gap-soft",
            "ref": "--danger-soft",
