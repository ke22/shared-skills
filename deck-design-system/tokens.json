      "rules": {
        "stateColors": "danger/warning/success are semantic only; success means completed AND verified",
        "roleColors": "at most 4 roles, separated by lightness, always labelled, never red/amber/green",
        "spacing": "layout spacing (margins, gaps between blocks) uses multiples of 8; spacing inside a component may use multiples of 4",
        "fieldText": "text on the blue field is at least 24px bold or 32px",
        "inactive": "inactive text keeps >= 3:1 because it still carries information"
      },
